<?xml version="1.0"?>
<package format="3">
  <name>unitree_camera_node</name>
  <version>0.1.0</version>
  <description>ROS 2 node to stream Unitree H1-2 front camera using GStreamer</description>
  <maintainer email="t.raviteja@gmail.com">Raviteja</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>

  <exec_depend>opencv-python</exec_depend>

  <test_depend>pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
