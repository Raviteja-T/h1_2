<?xml version="1.0"?>
<package format="3">
  <name>unitree_h1_2_description</name>
  <version>0.0.1</version>
  <description>Unitree H1-2 robot description package for ROS 2 Humble</description>

  <maintainer email="t.raviteja@gmail.com">Ravi</maintainer>
  <license>MIT</license>

  <!-- Build tool -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Runtime dependencies -->
  <exec_depend>xacro</exec_depend>
  <exec_depend>urdf</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <!-- Optional: if your Python script uses rclpy -->
  <exec_depend>rclpy</exec_depend>

  <!-- Linting (optional) -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

